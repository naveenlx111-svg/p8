# Reasoning model: ollama | gemini | anthropic | openai | scripted (scripted = offline test double, NOT AI)
# Local default: Ollama qwen2.5:7b (best speed/accuracy on an 8 GB GPU in our benchmark). Run: ollama pull qwen2.5:7b
PATHLENS_PROVIDER=ollama
PATHLENS_MODEL=qwen2.5:7b
# always | fallback | off. Local text model: off. Cloud vision models (e.g. Gemini Flash): always
PATHLENS_VISION_MODE=off
PATHLENS_MODEL_TIMEOUT_S=90
PATHLENS_TARGET_URL=http://127.0.0.1:4173/
PATHLENS_HEADLESS=true
PATHLENS_OLLAMA_BASE_URL=http://127.0.0.1:11434

# Cloud alternative (the Dockerfile defaults to this):
#   PATHLENS_PROVIDER=gemini  PATHLENS_MODEL=gemini-3-flash-preview  PATHLENS_VISION_MODE=always
# API keys (Gemini accepts GEMINI_API_KEY or GOOGLE_API_KEY)
GEMINI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# OpenAI-compatible endpoint (Groq, OpenRouter, vLLM...)
PATHLENS_OPENAI_BASE_URL=
