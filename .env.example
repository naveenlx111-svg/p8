# Reasoning model: gemini | anthropic | openai | ollama | scripted (scripted = offline test double, NOT AI)
PATHLENS_PROVIDER=gemini
# Optional model override (defaults: gemini-2.5-flash / claude-opus-5 / gpt-4.1-mini / ollama qwen2.5:7b)
PATHLENS_MODEL=gemini-2.5-flash
# always | fallback | off (Gemini Flash has fast multimodal vision)
PATHLENS_VISION_MODE=always
PATHLENS_TARGET_URL=http://127.0.0.1:4173/
PATHLENS_HEADLESS=true

# API Keys (Gemini supports GEMINI_API_KEY or GOOGLE_API_KEY)
GEMINI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Ollama / Local config (only if PATHLENS_PROVIDER=ollama)
PATHLENS_OLLAMA_BASE_URL=http://127.0.0.1:11434
# OpenAI-compatible endpoint (Groq, OpenRouter, vLLM...)
PATHLENS_OPENAI_BASE_URL=

